NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onesysuser

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REFRESH_TOKEN_TTL_SECONDS=604800
SET_PASSWORD_TOKEN_TTL_SECONDS=900
USER_INVITE_TOKEN_TTL_SECONDS=86400
BCRYPT_SALT_ROUNDS=12

CORS_ORIGIN=http://localhost:3000

WEB_APP_URL=http://localhost:3000
ORG_VERIFICATION_EXPIRES_HOURS=24

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OneSysUser <no-reply@onesysuser.local>
